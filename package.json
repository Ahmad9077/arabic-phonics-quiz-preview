{
  "name": "arabic-phonics-quiz-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode preview --port 4173",
    "build": "npm run build:preview",
    "build:preview": "tsc -b && vite build --mode preview",
    "build:hub": "tsc -b && vite build --mode production-hub",
    "preview:dist": "vite preview --port 4173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:audio": "bash scripts/generate-audio.sh",
    "validate:audio": "node scripts/validate-audio.mjs",
    "validate:audio-comparison": "node scripts/validate-audio-comparison.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "generate:hub-seed": "node scripts/generate-hub-seed.mjs",
    "validate:hub-seed": "node scripts/generate-hub-seed.mjs --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:audio && npm run validate:audio-comparison && npm run validate:manifest && npm run validate:hub-seed && npm run build:preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.17.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
